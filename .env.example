# VOICEVOXエンジンの設定
VOICEVOX_URL=http://localhost:50021
VOICEVOX_SPEAKER=3        # 3=ずんだもん(ノーマル), 1=ずんだもん(あまあま)
VOICEVOX_SPEED=1.1

# Pexels APIキー（無料登録: https://www.pexels.com/api/）
PEXELS_API_KEY=your_pexels_api_key_here

# 動画設定
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30

# 字幕スタイル
SUBTITLE_FONT=Noto Sans CJK JP
SUBTITLE_FONT_SIZE=52
SUBTITLE_OUTLINE=3
SUBTITLE_MARGIN_V=60
