# Claude API（台本自動生成に使用）
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Pexels APIキー（無料登録: https://www.pexels.com/api/）
PEXELS_API_KEY=your_pexels_api_key_here

# Style-BERT-VITS2 TTS設定
# スピーカー: jvnv-M1-jp（男性1） / jvnv-M2-jp（男性2） / jvnv-F1-jp（女性1） / jvnv-F2-jp（女性2）
TTS_SPEAKER=jvnv-M1-jp
TTS_SPEED=1.1
TTS_STYLE=Neutral
TTS_DEVICE=cpu   # cuda が使える環境なら cuda に変更すると高速化

# 動画設定
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30

# 字幕スタイル
SUBTITLE_FONT=Noto Sans CJK JP
SUBTITLE_FONT_SIZE=52
SUBTITLE_OUTLINE=3
SUBTITLE_MARGIN_V=60
